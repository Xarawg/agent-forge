# Скопировать в .env и заполнить. .env в .gitignore (SPEC.md NFR-3).

# Общий fallback (SPEC.md FR-6): OpenAI-совместимый endpoint
# FORGE_BASE_URL=https://api.deepseek.com
# FORGE_API_KEY=sk-...

# Переопределения по ролям (опционально):
# FORGE_PLANNER_BASE_URL=...
# FORGE_PLANNER_API_KEY=...
# FORGE_PLANNER_MODEL=deepseek-reasoner
# FORGE_CODER_MODEL=deepseek-chat
# FORGE_REVIEWER_MODEL=deepseek-chat
# FORGE_REPAIR_MODEL=deepseek-chat

# Провайдерские ключи (используются пресетами config/providers/*.yaml):
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Пресет провайдера по умолчанию:
# FORGE_PROVIDER=config/providers/deepseek.yaml

# Mock-режим без API-ключа (CI и разработка):
# FORGE_MOCK=1
